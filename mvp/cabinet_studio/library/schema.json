          "key": "protocol",
          "label": "Network protocol",
          "type": "choice",
          "required": true,
          "group": "specifications",
          "help": "Protocol the panel uses to reach the PLC.",
          "placeholder": "",
          "options": [
            "EtherNet/IP",
            "PROFINET",
            "Modbus TCP"
          ]
        }
      ]
    },
