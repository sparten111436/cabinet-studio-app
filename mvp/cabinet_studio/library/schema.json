{
  "version": 1,
  "groups": [
    {
      "id": "identity",
      "title": "Identity",
      "prompt": "Name the device so the schematic, the HMI, and the PLC all use the same tag."
    },
    {
      "id": "specifications",
      "title": "Specifications",
      "prompt": "Capture the ratings that change protection, wiring, and the program."
    },
    {
      "id": "wiring",
      "title": "Wiring",
      "prompt": "Landings and wire numbers are how the panel gets built without a phone call."
    },
    {
      "id": "plc_io",
      "title": "PLC I/O",
      "prompt": "Every device the PLC supervises needs an I/O or network placeholder before it is forgotten."
    },
    {
      "id": "notes",
      "title": "Notes",
      "prompt": "Write down what the next person must not have to rediscover."
    }
  ],
  "common_fields": [
    {
      "key": "tag",
      "label": "Tag / name",
      "type": "text",
      "required": true,
      "group": "identity",
      "help": "Unique tag used on the schematic, HMI, and PLC.",
      "placeholder": "MTR1"
    },
    {
      "key": "description",
      "label": "Description",
      "type": "text",
      "required": true,
      "group": "identity",
      "help": "What this device does in the process, in one line.",
      "placeholder": "Conveyor drive motor"
    },
    {
      "key": "vendor",
      "label": "Vendor",
      "type": "choice",
      "required": true,
      "group": "identity",
      "help": "Use Generic / Modbus when the brand is not chosen or the device speaks Modbus.",
      "placeholder": "",
      "options": [
        "Allen-Bradley",
        "Siemens",
        "Omron",
        "Generic / Modbus",
        "Hoffman",
        "Saginaw",
        "Hammond"
      ]
    },
    {
      "key": "catalog",
      "label": "Catalog / part number",
      "type": "text",
      "required": false,
      "group": "identity",
      "help": "Catalog number if it is known. Leave it blank until the BOM is firm.",
      "placeholder": "25B-D6P0N104"
    },
    {
      "key": "mounting",
      "label": "Mounting",
      "type": "choice",
      "required": false,
      "group": "identity",
      "help": "Where the device lives. Field devices still belong on the layout so they are not forgotten.",
      "placeholder": "",
      "options": [
        "In cabinet",
        "On door",
        "Field device",
        "Wall",
        "Freestanding"
      ]
    },
    {
      "key": "terminal_landings",
      "label": "Terminal landings",
      "type": "multiline",
      "required": true,
      "group": "wiring",
      "help": "Where each conductor lands. Example: TB1-14 to VFD T1, PE to ground bar.",
      "placeholder": ""
    },
    {
      "key": "wire_numbers",
      "label": "Wire numbers",
      "type": "text",
      "required": true,
      "group": "wiring",
      "help": "Numbers to print on the conductors. Example: W101, W102, PE.",
      "placeholder": "W101, W102, PE"
    },
    {
      "key": "wire_color",
      "label": "Wire color",
      "type": "text",
      "required": false,
      "group": "wiring",
      "help": "Shop color for this circuit. A suggestion can fill it. Change it when the circuit is special.",
      "placeholder": "Black"
    },
    {
      "key": "wire_gauge",
      "label": "Wire gauge",
      "type": "text",
      "required": false,
      "group": "wiring",
      "help": "Conductor size (AWG). Suggestion uses US industrial panel defaults; confirm against the load.",
      "placeholder": "18 AWG"
    },
    {
      "key": "io_direction",
      "label": "PLC I/O direction",
      "type": "choice",
      "required": true,
      "group": "plc_io",
      "help": "How the PLC supervises this device. Pick network if there is no discrete point.",
      "placeholder": "",
      "options": [
        "Input",
        "Output",
        "Input and Output",
        "Network / no discrete I/O"
      ]
    },
    {
      "key": "io_address",
      "label": "PLC I/O address",
      "type": "text",
      "required": true,
      "group": "plc_io",
      "help": "Address placeholder. Use a rack/slot/bit, a %I address, or a Modbus reference. For a networked device, enter the IP or tag and say so in notes.",
      "placeholder": "Local:1:I.Data.0"
    },
    {
      "key": "notes",
      "label": "Notes",
      "type": "multiline",
      "required": false,
      "group": "notes",
      "help": "Anything install, programming, or the next shift must not forget.",
      "placeholder": ""
    },
    {
      "key": "outline_w_mm",
      "label": "Outline width (mm)",
      "type": "text",
      "required": false,
      "group": "specifications",
      "help": "Maker outline width used for the panel layout footprint.",
      "placeholder": "45"
    },
    {
      "key": "outline_h_mm",
      "label": "Outline height (mm)",
      "type": "text",
      "required": false,
      "group": "specifications",
      "help": "Maker outline height used for the panel layout footprint.",
      "placeholder": "90"
    },
    {
      "key": "outline_d_mm",
      "label": "Outline depth (mm)",
      "type": "text",
      "required": false,
      "group": "specifications",
      "help": "Maker depth off the plate / behind the door; check enclosure depth and door clearance.",
      "placeholder": "75"
    }
  ],
  "types": [
    {
      "id": "plc",
      "label": "PLC",
      "category": "Control",
      "accent": "#3d8bfd",
      "supervised": true,
      "tile_w": 220,
      "tile_h": 104,
      "descriptor_keys": [
        "catalog",
        "protocol"
      ],
      "field_overrides": {
        "catalog": {
          "required": true,
          "help": "CPU catalog number is required so the rack and firmware stay matched."
        }
      },
      "fields": [
        {
          "key": "ip_address",
          "label": "IP address",
          "type": "text",
          "required": true,
          "group": "specifications",
          "help": "Controller IP on the machine network.",
          "placeholder": "192.168.1.10"
        },
        {
          "key": "slot_count",
          "label": "Slots / local I/O",
          "type": "text",
          "required": true,
          "group": "specifications",
          "help": "Rack slots, or a note such as embedded I/O only.",
          "placeholder": "8"
        },
        {
          "key": "protocol",
          "label": "Network protocol",
          "type": "choice",
          "required": true,
          "group": "specifications",
          "help": "How the PLC talks to drives, HMIs, and remote I/O.",
          "placeholder": "",
          "options": [
            "EtherNet/IP",
            "PROFINET",
            "Modbus TCP"
          ]
        }
      ]
    },
    {
      "id": "hmi",
      "label": "HMI",
      "category": "Operator",
