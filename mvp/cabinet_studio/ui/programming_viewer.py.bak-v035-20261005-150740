    def _mount_ladder_canvas(self, parent) -> None:
        """Create ladder canvas + scrollbars under parent (home body or pop-out)."""
        self.ladder_wrap = ctk.CTkFrame(parent, fg_color=PANEL, corner_radius=0)
        self.canvas = tk.Canvas(self.ladder_wrap, background=LADDER_BG, highlightthickness=0)
        self.vbar = ctk.CTkScrollbar(self.ladder_wrap, orientation="vertical", command=self.canvas.yview)
        self.hbar = ctk.CTkScrollbar(self.ladder_wrap, orientation="horizontal", command=self.canvas.xview)
        self.canvas.configure(yscrollcommand=self.vbar.set, xscrollcommand=self.hbar.set)
        self.vbar.pack(side="right", fill="y")
        self.hbar.pack(side="bottom", fill="x")
        self.canvas.pack(side="left", fill="both", expand=True)
        self.canvas.bind("<Configure>", self._on_canvas_configure)
        self.canvas.bind("<Button-1>", self._on_canvas_click)
        self.canvas.bind("<Motion>", self._on_canvas_motion)
        self.canvas.bind("<Leave>", self._hide_hover_tip)
        self.canvas.bind("<MouseWheel>", self._wheel)
        self.canvas.bind("<Shift-MouseWheel>", self._wheel_x)
        self.canvas.bind("<Button-4>", lambda _e: self.canvas.yview_scroll(-1, "units"))
        self.canvas.bind("<Button-5>", lambda _e: self.canvas.yview_scroll(1, "units"))
        self.ladder_wrap.bind("<MouseWheel>", self._wheel)
        self.ladder_wrap.bind("<Shift-MouseWheel>", self._wheel_x)
        self.vbar.bind("<MouseWheel>", self._wheel)
